# Absolute base URL of the deployed site, with protocol and no trailing slash.
#
# Used as metadataBase for Open Graph and Twitter tags, and as the base for
# robots.txt and sitemap.xml. Falls back to http://localhost:3000 when unset,
# which is correct for local development but wrong in production: leaving it
# unset on a deployment means shared links resolve their images and canonical
# URLs against localhost.
#
# Example: NEXT_PUBLIC_SITE_URL=https://loomiestudio.com
NEXT_PUBLIC_SITE_URL=
