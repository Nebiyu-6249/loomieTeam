# ============================================================================
# Loomie — environment
#
# Copy to .env.local and fill in. Nothing here has a working default; the
# application says what is missing rather than pretending, and the setup screen
# at /admin walks through the same list.
#
# The rule that matters: anything prefixed NEXT_PUBLIC_ is compiled into the
# browser bundle and is readable by anyone who visits the site. Everything else
# stays on the server. SUPABASE_SECRET_KEY must never gain that prefix — it
# bypasses row level security entirely.
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
#
# Project Settings → API. Without these the public site renders the seeded
# content in development with a warning, refuses to serve content pages in
# production, and the admin shows a setup screen.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses row level security. Used for exactly three things:
# writing a booking, writing an enquiry, and creating an administrator account.
SUPABASE_SECRET_KEY=

# Setup-time only, and not part of the deployed environment. Project Settings →
# Database → Connection string (URI). Used by npm run db:migrate / db:seed /
# db:test and by nothing at runtime.
SUPABASE_DB_URL=

# ── Email ───────────────────────────────────────────────────────────────────
#
# Resend. Without these the booking and enquiry routes refuse with a 503 that
# tells the visitor to write directly, rather than accepting something nobody
# will ever see.

RESEND_API_KEY=
BOOKING_FROM_EMAIL=
BOOKING_TO_EMAIL=

# Only set in tests, to point the sender at a stub.
# RESEND_API_URL=

# ── Rate limiting ───────────────────────────────────────────────────────────
#
# Optional. Upstash Redis, used for nothing but the request counter. Without it
# the limit applies per instance and resets on restart — a degraded defence
# rather than lost data, so this one is allowed to fall back in production and
# says so in the log.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── The site's own address ──────────────────────────────────────────────────
#
# Used for canonical URLs, the sitemap, OpenGraph images and the address a
# password-reset link comes back to. Without it these are written against
# http://localhost:3000, which is wrong in a way search engines will happily
# index — and the reset action refuses rather than emailing a link to the
# wrong host.

NEXT_PUBLIC_SITE_URL=

# ── Storage ─────────────────────────────────────────────────────────────────
#
# No variable, but worth stating here because it is where people look: media
# uploads go to a Supabase Storage bucket named `site`, which has to exist and
# be public. Public means the bytes are readable by anyone with the URL —
# before the image is used, while it is unpublished, and after it is detached.
# Row level security governs the media row, not the file.
