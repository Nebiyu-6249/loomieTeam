# ── Loomie environment ──────────────────────────────────────────────────────
# Copy to .env.local for development. Every variable below is read on the
# server only; none of them are exposed to the browser except where the name
# says NEXT_PUBLIC_.


# ── Site ────────────────────────────────────────────────────────────────────

# Absolute origin, used for metadata, OpenGraph image URLs and the sitemap.
# Optional in development; falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://loomiestudio.com


# ── Booking: availability ───────────────────────────────────────────────────

# IANA timezone the studio's working hours are defined in. The weekly pattern
# in lib/availability.ts is wall-clock time in this zone; everything the API
# emits is converted to UTC. Optional; defaults to Asia/Dubai.
STUDIO_TIMEZONE=Asia/Dubai


# ── Booking: delivery (REQUIRED to accept bookings) ─────────────────────────
#
# All three must be set or POST /api/booking returns 503 and the panel tells
# the visitor to email instead. It never reports a booking it did not make.
#
# Sign up at resend.com, verify the sending domain, then:

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The From address. Must be on a domain verified with Resend.
BOOKING_FROM_EMAIL=bookings@loomiestudio.com

# Where booking notifications land. The studio's own inbox.
BOOKING_TO_EMAIL=hello@loomiestudio.com

# Optional. Point the delivery call at a Resend-compatible relay instead of
# Resend itself. Leave unset in production.
# RESEND_API_URL=https://api.resend.com/emails


# ── Booking: persistence (REQUIRED in production) ───────────────────────────
#
# Without these the diary is held in process memory: it is lost on restart and
# is not shared between serverless instances, so two visitors can book the
# same slot. Fine locally and for the test suite; in production the route
# refuses bookings outright rather than accepting them into a Map, returning
# 503 and pointing the visitor at email.
#
# Create a database at upstash.com and copy the REST credentials. Any
# equivalent REST datastore can be substituted by implementing the
# BookingStore interface in lib/bookingStore.ts.

UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxx
